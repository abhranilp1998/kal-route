  "fixed_sql": [
    {
      "name": "places",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"places\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"lat\" REAL NOT NULL, \"lng\" REAL NOT NULL, \"address\" TEXT NULL, \"emoji\" TEXT NOT NULL DEFAULT '📍', \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "trips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trips\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" INTEGER NOT NULL, \"from_place_id\" INTEGER NOT NULL REFERENCES places (id) ON DELETE CASCADE, \"to_place_id\" INTEGER NOT NULL REFERENCES places (id) ON DELETE CASCADE, \"arrive_by\" INTEGER NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'planned', \"leave_at\" INTEGER NULL, \"buffer_minutes\" INTEGER NOT NULL DEFAULT 0, \"route_json\" TEXT NULL, \"route_fetched_at\" INTEGER NULL, \"route_source\" TEXT NULL);"
        }
      ]
    },
